<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the app by Capacitor's own manifest merger, so the CI build does not
     have to inject these. This is the tracking-only half of the driver app: no camera,
     no driver monitoring, no alerts, so the camera permission and the camera foreground
     service type are not asked for at all. What is left is what a locked phone needs to
     go on reporting positions and to keep the blackbox running. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The service keeps a trip's positions on the road once the page has been frozen,
         and API 34 will not let a location-type foreground service run without this. The
         location permissions themselves belong to the app: the background watcher plugin
         already asks for them, and asks for "all the time", which is the only answer that
         lets a locked phone go on reporting. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- The screen is off while the vehicle is moving, and the runner still has to sample
         and store, so the service holds a partial wake lock for as long as it is running. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- A wake lock keeps the CPU awake while the service runs, but it is Android's own
         battery saving that puts an app to sleep between trips and defers its uploads.
         This permission is what lets the app ask the driver, once, to keep this one out
         of that saving; it is a normal permission, so it is granted at install and never
         at runtime, and declining it on the settings screen changes nothing here. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- The runner is what reports a trip, and a handset rebooted at a depot takes it down with
         it. This is what lets the app hear about the reboot and bring it back, rather than
         waiting for the driver to open the app and notice. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <service
            android:name="com.fleet.dms.DmsService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <!-- exported is required true for a system broadcast on API 31 and later; the receiver
             answers nothing else, does nothing unless the office's order still stands, and
             starts the location runner only. See BootReceiver. -->
        <receiver
            android:name="com.fleet.dms.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
